{
  "version": 1,
  "targets": {
    "archive": {
      "dir": ".",
      "workspace": ".",
      "inputs": ["go.mod", "go.sum", "cmd", "internal", "schemas"]
    },
    "workflows": {"dir": ".", "workspace": ".", "inputs": [".github"]}
  },
  "environments": {
    "go": {"executor": "dagger"}
  },
  "checks": {
    "lint": {"kind": "go-lint", "target": "archive", "environment": "go"},
    "vet": {"kind": "go-vet", "target": "archive", "environment": "go"},
    "http": {"kind": "go-http", "target": "archive", "environment": "go"},
    "sql": {"kind": "go-sql", "target": "archive", "environment": "go"},
    "modules": {"kind": "go-mod", "target": "archive", "environment": "go"},
    "vulnerabilities": {"kind": "go-vuln", "target": "archive", "environment": "go"},
    "workflow-lint": {"kind": "workflow-lint", "target": "workflows", "environment": "go"},
    "workflow-security": {"kind": "workflow-security", "target": "workflows", "environment": "go"}
  },
  "runs": {
    "branch": {"checks": ["lint", "vet"]},
    "pre-merge": {"checks": ["lint", "vet", "http", "sql", "modules", "vulnerabilities", "workflow-lint", "workflow-security"]},
    "main": {"checks": ["lint", "vet", "http", "sql", "modules", "vulnerabilities", "workflow-lint", "workflow-security"], "rerun_checks": true}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/wangjohn/agent-archive/main/schemas/source-bundle.schema.json",
  "title": "Agent Archive filtered source bundle line (schemas 2 and 3)",
  "description": "A source bundle is stored as source.<sha256>.jsonl.gz: gzip of newline-delimited JSON, where <sha256> is the SHA-256 of the exact compressed bytes. This schema describes one line; every line is exactly one object and ends with a newline. Ordering rules, which a line-level schema cannot express: the first line is the only 'header' line; then every 'native_record' line, in native source order; then every 'native_text' line; then every 'supplemental_evidence' line. The header's counts equal the number of lines of each kind that follow it. A line may be at most 64 MiB plus 1 MiB of envelope. Serialization is deterministic (fixed field order, sorted object keys, fixed gzip header), so identical evidence yields identical bytes. Schema 1, a single JSON document stored as source.<sha256>.json.gz, is not read.",
  "type": "object",
  "required": [
    "kind"
  ],
  "oneOf": [
    {
      "$ref": "#/$defs/header_line"
    },
    {
      "$ref": "#/$defs/native_record_line"
    },
    {
      "$ref": "#/$defs/native_text_line"
    },
    {
      "$ref": "#/$defs/supplemental_evidence_line"
    }
  ],
  "$defs": {
    "header_line": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "schema_version",
        "archive_session_id",
        "native_session_id",
        "project_id",
        "capture",
        "counts"
      ],
      "properties": {
        "kind": {
          "const": "header"
        },
        "schema_version": {
          "enum": [
            2,
            3
          ]
        },
        "archive_session_id": {
          "type": "string",
          "minLength": 1
        },
        "native_session_id": {
          "type": "string",
          "minLength": 1
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "capture": {
          "$ref": "#/$defs/capture"
        },
        "native_child": {"type": "boolean", "description": "Native child ownership, independent of parent link availability."},
"parent_session_id": {
          "type": "string",
          "minLength": 1
        },
        "linked_sessions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/linked_session"
          }
        },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "native_records",
            "native_text",
            "supplemental_evidence"
          ],
          "properties": {
            "native_records": {
              "type": "integer",
              "minimum": 0
            },
            "native_text": {
              "type": "integer",
              "minimum": 0
            },
            "supplemental_evidence": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "previous_generation_id": {
          "type": "string",
          "minLength": 1,
          "description": "Previous archive generation, independent of parent_session_id subagent lineage."
        },
        "history": {
          "$ref": "#/$defs/history"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "schema_version": {
                "const": 3
              }
            }
          },
          "then": {
            "required": [
              "history"
            ]
          },
          "else": {
            "not": {
              "required": [
                "history"
              ]
            }
          }
        }
      ]
    },
    "native_record_line": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "record"
      ],
      "properties": {
        "kind": {
          "const": "native_record"
        },
        "record": {
          "type": "object",
          "minProperties": 1,
          "description": "One filtered native record, keeping the harness's own field names and structure."
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        }
      }
    },
    "native_text_line": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "format",
        "content"
      ],
      "properties": {
        "kind": {
          "const": "native_text"
        },
        "format": {
          "type": "string"
        },
        "content": {
          "type": "string"
        }
      }
    },
    "supplemental_evidence_line": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "evidence"
      ],
      "properties": {
        "kind": {
          "const": "supplemental_evidence"
        },
        "evidence": {
          "$ref": "#/$defs/supplemental",
          "description": "Nested because evidence has its own 'kind' (skill_inventory, final_response, ...)."
        }
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "harness",
        "adapter_name",
        "adapter_version",
        "source_format",
        "boundary",
        "filter_version",
        "captured_at"
      ],
      "properties": {
        "harness": {
          "$ref": "#/$defs/harness"
        },
        "adapter_name": {
          "type": "string"
        },
        "adapter_version": {
          "type": "string"
        },
        "source_format": {
          "type": "string"
        },
        "boundary": {
          "$ref": "#/$defs/boundary"
        },
        "filter_version": {
          "type": "string"
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        },
        "gaps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/gap"
          }
        },
        "origin": {
          "enum": [
            "discovery"
          ],
          "description": "Source admitted by local discovery, without inferred hook execution."
        }
      }
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "mode": {
          "type": "string"
        }
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retained_records",
        "retained_bytes"
      ],
      "properties": {
        "retained_records": {
          "type": "integer",
          "minimum": 0
        },
        "retained_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/gap_code"
        },
        "record": {
          "type": "integer",
          "minimum": 1
        },
        "detail": {
          "type": "string",
          "description": "Archive-authored description of the omission. Never a transcript value. From filter version 3 the single unknown_field_omitted gap carries the distinct omitted key names, sorted and capped, as 'omitted keys: a, b, c'. A subagent_transcript_never_written gap carries the fixed text 'Claude Code reported a subagent but never wrote its transcript'."
        }
      }
    },
    "supplemental": {
      "type": "object",
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "session_labels"}}, "required": ["kind"]},
          "then": {
            "properties": {
              "provenance": {"type": "string", "pattern": "^native:[A-Za-z0-9_.-]{1,64}:session_labels$"},
              "payload": {
                "type": "object",
                "additionalProperties": false,
                "required": ["native_session_id", "state", "source", "contract"],
                "properties": {
                  "native_session_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,256}$"},
                  "state": {"enum": ["present", "confirmed_absent"]},
                  "name": {"type": "string", "minLength": 1, "maxLength": 512},
                  "source": {"enum": ["index", "database", "api"]},
                  "contract": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$"}
                },
                "allOf": [{"if": {"properties": {"state": {"const": "present"}}}, "then": {"required": ["name"]}, "else": {"not": {"required": ["name"]}}}]
              }
            }
          }
        }
      ],
      "additionalProperties": false,
      "required": [
        "kind",
        "observed_at",
        "provenance",
        "payload"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "provenance": {
          "type": "string"
        },
        "payload": {
          "type": "object"
        }
      }
    },
    "linked_session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "relationship",
        "status",
        "observed_at"
      ],
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "relationship": {
          "const": "subagent"
        },
        "status": {
          "enum": [
            "pending",
            "published",
            "unavailable"
          ]
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "gap_code": {
      "description": "An archive-authored reason. The enum lists every code this version writes (internal/archive CaptureGapCodes; dev/specs/privacy-filter.md says what each means). A reader must accept any other lowercase code, which an older or newer writer may use.",
      "anyOf": [
        {
          "enum": [
            "binary_content_omitted",
            "content_truncated",
            "cursor_blob_content_unavailable",
            "cursor_bubble_id_mismatch",
            "cursor_bubble_missing",
            "cursor_chat_rewritten",
            "cursor_context_omitted",
            "cursor_incomplete_tail_omitted",
            "cursor_inline_conversation_omitted",
            "cursor_message_type_unknown",
            "cursor_tool_argument_omitted",
            "hidden_instruction_omitted",
            "hidden_or_unknown_nested_content_omitted",
            "imported_without_hook_evidence",
            "incomplete_or_invalid_record",
            "record_without_allowed_fields_omitted",
            "sensitive_content_redacted",
            "sensitive_or_hidden_field_omitted",
            "subagent_final_not_reconciled",
            "native_parent_link_pending",
            "native_child_link_unverified",
            "subagent_identity_unavailable",
            "subagent_transcript_never_written",
            "supplemental_evidence_omitted",
            "text_structure_partial",
            "unknown_field_omitted",
            "unknown_record_type",
            "unsupported_value_omitted",
            "discovered_without_hook_evidence",
            "recovered_generation",
            "history_cumulative_tokens_unavailable",
            "own_usage_observations_partial",
            "cache_reasoning_cost_unqualified"
          ]
        },
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        }
      ]
    },
    "history_span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rollout_id",
        "thread_id",
        "first_record",
        "end_record",
        "start_ordinal",
        "end_ordinal_exclusive"
      ],
      "properties": {
        "rollout_id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "thread_id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "first_record": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "end_record": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "start_ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "end_ordinal_exclusive": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        }
      }
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active_rollout_id",
        "thread_id",
        "spans"
      ],
      "properties": {
        "active_rollout_id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "thread_id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "own_start_ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "spans": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/history_span"
          }
        }
      }
    }
  }
}

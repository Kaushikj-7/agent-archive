{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/wangjohn/agent-archive/main/schemas/historical-project-proof.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "destination_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "original_cwd": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^/[^\u0000\\r\\n]*$"
    },
    "canonical_cwd": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^/[^\u0000\\r\\n]*$"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\u0000-\u001f\u007f]+$"
    },
    "source_cwds": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "pattern": "^/[^\u0000\\r\\n]*$"
      }
    }
  },
  "required": [
    "version",
    "project_id",
    "destination_id",
    "original_cwd",
    "canonical_cwd",
    "label"
  ]
}

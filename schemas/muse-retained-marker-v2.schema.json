{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/wangjohn/agent-archive/main/schemas/muse-retained-marker-v2.schema.json",
  "title": "Muse timestamp-free omission v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "kind",
    "pos",
    "stream",
    "position",
    "schema",
    "marker",
    "omitted_record"
  ],
  "properties": {
    "v": {
      "const": 2
    },
    "kind": {
      "const": "native_omission"
    },
    "pos": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "line",
        "child"
      ],
      "properties": {
        "line": {
          "type": "integer",
          "minimum": 2,
          "maximum": 9007199254740991
        },
        "child": {
          "type": "null"
        }
      }
    },
    "stream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "const": "session"
        },
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        }
      }
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sequence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 3,
          "maximum": 9007199254740991
        }
      }
    },
    "schema": {
      "const": 1
    },
    "marker": {
      "type": "string"
    },
    "omitted_record": {
      "type": "object"
    }
  },
  "oneOf": [
    {
      "description": "A native live-only task delta marker.",
      "properties": {
        "marker": {
          "const": "omitted_live_only"
        },
        "omitted_record": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "record_type",
            "durability",
            "payload_type",
            "payload_schema_version",
            "payload_kind",
            "omission_class"
          ],
          "properties": {
            "record_type": {
              "const": "status"
            },
            "durability": {
              "const": "ephemeral"
            },
            "payload_type": {
              "const": "runtime.session"
            },
            "payload_schema_version": {
              "const": 1
            },
            "payload_kind": {
              "const": "task"
            },
            "omission_class": {
              "const": "task_tool_delta_v1"
            }
          }
        }
      }
    },
    {
      "description": "A record this adapter version does not support, or a workflow-engine fact, omitted with nothing of it kept.",
      "properties": {
        "marker": {
          "const": "unsupported_record_omitted"
        },
        "omitted_record": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "record_type",
            "durability",
            "payload_type",
            "payload_schema_version",
            "payload_kind",
            "omission_class"
          ],
          "properties": {
            "record_type": {
              "const": "event"
            },
            "durability": {
              "const": "durable"
            },
            "payload_type": {
              "const": ""
            },
            "payload_schema_version": {
              "const": 0
            },
            "payload_kind": {
              "const": ""
            },
            "omission_class": {
              "enum": [
                "unsupported_record_v1",
                "workflow_fact_v1"
              ]
            }
          }
        }
      }
    }
  ]
}
